ANTHROPIC_API_KEY=

# Optional. Defaults: 127.0.0.1 and 4317. The container image sets JABUTI_HOST=0.0.0.0.
# JABUTI_HOST=127.0.0.1
# JABUTI_PORT=4317
# Where the database, agent state and traces live. Default: ./data (container: /data).
# JABUTI_DATA_DIR=
# Encrypts stored secrets, at least 16 characters. Default: generated in the data
# directory (data/secret.key). README → Secret key moves it here without losing secrets.
# JABUTI_SECRET_KEY=
